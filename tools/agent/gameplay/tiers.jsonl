// Each tier opens its own number of the panel's 32 slots: worn, an iron backpack opens 16, and a click
// on a locked slot past them does nothing; a netherite one opens all 32.
//   python tools/agent/new_world.py <node> BackpackAgent
//   ./gradlew ":<node>:runClient" -Pagent=tools/agent/gameplay/tiers.jsonl -Pquickplay=BackpackAgent
//   python tools/agent/drive.py run/<node>/agent/client tools/agent/gameplay/tiers.jsonl --verify --max-age 10
// Any node. Clicks are measured from the centre of the inventory screen: the panel's slots are in rows
// of four, the first 160 left and 59 up, 18 apart each way, so slot 12 (the first of row four) is 160
// left and 5 up, and slot 20 (row six, locked on iron) 160 left and 31 down. The first hotbar slot
// is 72 left and 67 down. Look at the captures `iron` and `netherite`.
{"id": "settle", "command": "wait", "args": {"ticks": 300}, "expect": {"ok": true}}
{"id": "clear", "command": "server.command", "args": {"command": "clear @a"}, "expect": {"ok": true}}
{"id": "wearIron", "command": "server.command", "args": {"command": "item replace entity @a armor.chest with backpacksrefined:iron_backpack"}, "expect": {"ok": true}}
{"id": "give", "command": "server.command", "args": {"command": "give @a minecraft:diamond 5"}, "expect": {"ok": true}}
{"id": "given", "command": "wait", "args": {"ticks": 10}, "expect": {"ok": true}}
{"id": "inventory", "command": "client.screen", "args": {"open": "inventory"}, "expect": {"ok": true}}
{"id": "loaded", "command": "wait", "args": {"ticks": 10}, "expect": {"ok": true}}
{"id": "iron", "command": "client.capture", "args": {"name": "iron"}, "expect": {"ok": true}}
{"id": "pick", "command": "client.click", "args": {"x": -72, "y": 67}, "expect": {"ok": true}}
{"id": "picked", "command": "wait", "args": {"ticks": 5}, "expect": {"ok": true}}
{"id": "locked", "command": "client.click", "args": {"x": -160, "y": 31}, "expect": {"ok": true, "result.taken": true}}
{"id": "lockedWait", "command": "wait", "args": {"ticks": 5}, "expect": {"ok": true}}
{"id": "stillCarried", "command": "client.slots", "expect": {"ok": true, "result.carried.item": "minecraft:diamond", "result.carried.count": 5}}
{"id": "open", "command": "client.click", "args": {"x": -160, "y": -5}, "expect": {"ok": true, "result.taken": true}}
{"id": "openWait", "command": "wait", "args": {"ticks": 5}, "expect": {"ok": true}}
{"id": "stored", "command": "client.slots", "expect": {"ok": true, "result.carried.item": "minecraft:air"}}
{"id": "ironAfter", "command": "client.capture", "args": {"name": "ironStored"}, "expect": {"ok": true}}
{"id": "close", "command": "client.screen", "args": {"open": "none"}, "expect": {"ok": true}}
{"id": "wearNetherite", "command": "server.command", "args": {"command": "item replace entity @a armor.chest with backpacksrefined:netherite_backpack"}, "expect": {"ok": true}}
{"id": "worn", "command": "wait", "args": {"ticks": 10}, "expect": {"ok": true}}
{"id": "inventoryAgain", "command": "client.screen", "args": {"open": "inventory"}, "expect": {"ok": true}}
{"id": "loadedAgain", "command": "wait", "args": {"ticks": 10}, "expect": {"ok": true}}
{"id": "netherite", "command": "client.capture", "args": {"name": "netherite"}, "expect": {"ok": true}}
